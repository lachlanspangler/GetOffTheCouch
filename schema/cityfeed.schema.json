{
  "$defs": {
    "Availability": {
      "enum": [
        "on_sale",
        "limited",
        "few_left",
        "sold_out",
        "not_yet_on_sale",
        "registration_open",
        "registration_closed",
        "waitlist",
        "free_no_ticket",
        "cancelled",
        "postponed",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "CityCoverage": {
      "additionalProperties": false,
      "description": "Per-city coverage + go-live tier, computed by ``gotc gate``. The UI never computes coverage itself.",
      "properties": {
        "banner": {
          "default": false,
          "title": "Banner",
          "type": "boolean"
        },
        "criteria": {
          "additionalProperties": {
            "$ref": "#/$defs/CoverageCriterion"
          },
          "title": "Criteria",
          "type": "object"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "failing_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failing Since"
        },
        "geocode_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Geocode Rate",
          "type": "number"
        },
        "passed_hard": {
          "title": "Passed Hard",
          "type": "boolean"
        },
        "passed_soft": {
          "title": "Passed Soft",
          "type": "boolean"
        },
        "pillars": {
          "additionalProperties": {
            "$ref": "#/$defs/CoveragePillar"
          },
          "title": "Pillars",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "sources_healthy": {
          "minimum": 0,
          "title": "Sources Healthy",
          "type": "integer"
        },
        "sources_total": {
          "minimum": 0,
          "title": "Sources Total",
          "type": "integer"
        },
        "strongest": {
          "items": {
            "type": "string"
          },
          "title": "Strongest",
          "type": "array"
        },
        "tier": {
          "enum": [
            "live",
            "beta",
            "hidden"
          ],
          "title": "Tier",
          "type": "string"
        },
        "top_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Source"
        },
        "top_source_share": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Top Source Share",
          "type": "number"
        }
      },
      "required": [
        "tier",
        "evaluated_at",
        "passed_hard",
        "passed_soft",
        "sources_healthy",
        "sources_total",
        "geocode_rate"
      ],
      "title": "CityCoverage",
      "type": "object"
    },
    "CoverageCriterion": {
      "additionalProperties": false,
      "description": "One go-live gate criterion (docs/research/SCALING.md \u00a73, ADR-0008). ``None`` = not part of that bar.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "pass_hard": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Hard"
        },
        "pass_soft": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Soft"
        },
        "threshold": {
          "title": "Threshold",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "label",
        "threshold"
      ],
      "title": "CoverageCriterion",
      "type": "object"
    },
    "CoveragePillar": {
      "additionalProperties": false,
      "description": "A newcomer pillar's coverage: \u2713 strong, \u25d0 thin, \u2715 none.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "state": {
          "enum": [
            "strong",
            "thin",
            "none"
          ],
          "title": "State",
          "type": "string"
        },
        "threshold": {
          "minimum": 1,
          "title": "Threshold",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "count",
        "threshold",
        "state"
      ],
      "title": "CoveragePillar",
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "A modeled number. Always a band; ``mid`` is the point estimate shown with a '~'.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "mid": {
          "minimum": 0,
          "title": "Mid",
          "type": "number"
        }
      },
      "required": [
        "low",
        "mid",
        "high",
        "method",
        "confidence"
      ],
      "title": "Estimate",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "A canonical, deduplicated, enriched event \u2014 what the dashboard renders.",
      "properties": {
        "all_day": {
          "default": false,
          "title": "All Day",
          "type": "boolean"
        },
        "attendance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Estimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "city": {
          "title": "City",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        },
        "is_new": {
          "default": false,
          "title": "Is New",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "last_checked": {
          "format": "date-time",
          "title": "Last Checked",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "offers": {
          "items": {
            "$ref": "#/$defs/Offer"
          },
          "title": "Offers",
          "type": "array"
        },
        "organizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organizer"
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "price_trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceTrend"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldProvenance"
          },
          "title": "Provenance",
          "type": "object"
        },
        "rank": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recurrence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recurrence"
        },
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Registration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "series_dates": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Series Dates",
          "type": "array"
        },
        "series_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Id"
        },
        "social": {
          "anyOf": [
            {
              "$ref": "#/$defs/SocialScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "tickets": {
          "$ref": "#/$defs/TicketSignal"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "venue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Id"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "city",
        "title",
        "kind",
        "category",
        "start",
        "timezone",
        "location",
        "price",
        "sources",
        "first_seen",
        "last_checked"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "one_off",
        "recurring",
        "season",
        "opening",
        "deadline"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "FieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/Method",
          "default": "reported"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "fetched_at"
      ],
      "title": "FieldProvenance",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "geocode_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geocode Confidence"
        },
        "geocode_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/Method"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "neighborhood": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Neighborhood"
        },
        "venue_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Name"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Method": {
      "description": "How a value was obtained. Shown in the UI next to every non-reported value.",
      "enum": [
        "reported",
        "derived",
        "extracted",
        "estimated",
        "curated"
      ],
      "title": "Method",
      "type": "string"
    },
    "NeighborhoodPoint": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "lat",
        "lon"
      ],
      "title": "NeighborhoodPoint",
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "description": "A way to get in: a ticket listing, a registration page, an RSVP.",
      "properties": {
        "affiliate": {
          "default": false,
          "title": "Affiliate",
          "type": "boolean"
        },
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "unknown"
        },
        "fees_included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fees Included"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OfferKind"
        },
        "listing_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Count"
        },
        "price_max": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Max"
        },
        "price_min": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Min"
        },
        "seller": {
          "title": "Seller",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "seller",
        "kind",
        "url",
        "source_id",
        "fetched_at"
      ],
      "title": "Offer",
      "type": "object"
    },
    "OfferKind": {
      "enum": [
        "primary",
        "resale",
        "registration",
        "rsvp",
        "info"
      ],
      "title": "OfferKind",
      "type": "string"
    },
    "Price": {
      "additionalProperties": false,
      "description": "Price summary in USD. ``is_free`` is only true when a source said so.",
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "is_free": {
          "default": false,
          "title": "Is Free",
          "type": "boolean"
        },
        "max": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "Price",
      "type": "object"
    },
    "PricePoint": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "listing_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Count"
        },
        "price_max": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Max"
        },
        "price_min": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Min"
        },
        "seller": {
          "title": "Seller",
          "type": "string"
        }
      },
      "required": [
        "at",
        "seller"
      ],
      "title": "PricePoint",
      "type": "object"
    },
    "PriceTrend": {
      "additionalProperties": false,
      "properties": {
        "change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Pct"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "up",
            "down",
            "flat",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/PricePoint"
          },
          "title": "Points",
          "type": "array"
        },
        "window_hours": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Hours"
        }
      },
      "title": "PriceTrend",
      "type": "object"
    },
    "RankHints": {
      "additionalProperties": false,
      "description": "Profile-independent ranking hints precomputed at export (gotc/pipeline/rankprep.py, RANKING.md \u00a75.1).\n\nShort keys keep the card feed lean. Every value is derived from the event's own fields or run history.",
      "properties": {
        "complete": {
          "default": 0.0,
          "description": "completeness: share of 7 key fields present",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Complete",
          "type": "number"
        },
        "desc_len": {
          "default": 0,
          "description": "full description length in chars",
          "minimum": 0,
          "title": "Desc Len",
          "type": "integer"
        },
        "flags": {
          "description": "quality flags (admin, no_info, no_place, ...)",
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "fp": {
          "description": "near-duplicate fingerprint: equal fp = same listing (title|venue|local date)",
          "title": "Fp",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
