# Copy to .env (gitignored). Every key is optional: sources without their key show as
# "disabled: needs KEY" on the Health page instead of failing.

# Ticketmaster Discovery API — free, instant: https://developer-acct.ticketmaster.com/user/register
TICKETMASTER_API_KEY=
# SeatGeek Platform — client_id from https://seatgeek.com/account/develop (portal login required)
SEATGEEK_CLIENT_ID=
# Socrata app token — optional, raises rate limits on city open-data portals: https://dev.socrata.com/register
SOCRATA_APP_TOKEN=
# Meetup GraphQL OAuth client (planned): https://www.meetup.com/api/oauth/list/
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=
# Eventbrite private token (organizer/venue-scoped lookups only; search API is gone): https://www.eventbrite.com/platform/api-keys
EVENTBRITE_TOKEN=
# RunSignup API caller registration (free; needs a RunSignup account), required by the API Terms:
# https://runsignup.com/API/APIKeys → "API Caller Registration". Unlocks races + registration deadlines in every city.
RUNSIGNUP_API_REG=
RUNSIGNUP_API_REG_SECRET=

# Optional overrides
# GOTC_USER_AGENT="GetOffTheCouch/0.1 (+https://github.com/lachlanspangler/GetOffTheCouch; you@example.com)"
# GOTC_DATA_DIR=./data
# GOTC_OFFLINE=1
