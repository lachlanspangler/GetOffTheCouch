eal began creating a visual and discursive archive of Black student life on campus. Seeking to counter the systemic invisibility of his peers, Bereal embedded himself within the campus community, documenting personal histories in photographs and interviews. He called this project The Black Yearbook. Adraint Bereal: As It Appears expands on The Black Yearbook, juxtaposing archival images, texts, and video from UT and Austin repositories with over thirty photographs, essays, and interviews with Black students attending American universities.","photo_id":53511611674391,"speaker_ids":[],"feedback_enabled":false,"feedback_goal_ids":[],"featured_section_ids":[],"detail_views":352,"featured":false,"publish_status":"published","geo":{"latitude":"30.286256","longitude":"-97.732996","street":"2301 San Jacinto Boulevard","city":"Austin","state":"TX","country":"US","zip":"78705"},"departments":[{"id":47748598588893,"name":"Visual Arts Center"},{"id":47748619205969,"name":"Department of Art \u0026 Art History"},{"id":47748653246172,"name":"College of Fine Arts"}],"filters":{"event_import_type":[{"name":"COFA","id":32750722016348},{"name":"COFA/Visual Arts Center","id":32750727075614}],"event_target_audience":[{"name":"Students","id":24848},{"name":"General Public","id":24853}],"event_types":[{"name":"Arts \u0026 Humanities","id":24829}]},"custom_fields":{"on_view":"Yes"},"event_instances":[{"event_instance":{"id":53511611723548,"event_id":53511611721496,"start":"2026-10-16T00:00:00-05:00","end":null,"ranking":0.04,"all_day":true,"num_attending":0}}],"localist_url":"https://calendar.utexas.edu/event/adraint-bereal-as-it-appears","localist_ics_url":"https://calendar.utexas.edu/event/adraint-bereal-as-it-appears.ics","photo_url":"https://localist-images.azureedge.net/photos/53511611674391/huge/c13c24574099bfae385ebc65cd6c4b00cc7c97e1.jpg","venue_url":"https://calendar.utexas.edu/visual_arts_center_art_building_art_968"}},{"event":{"id":53175403864066,"title":"Experimental Seeing: R