,"address":"206 Washington Street","city":"Boston","country":"United States","state":"MA","zip":"02109","stateprovince":"MA","show_map":false,"show_map_link":false,"global_id":"www.downtownboston.org?id=6554","global_id_lineage":["www.downtownboston.org?id=6554"]},"organizer":[{"id":16317,"status":"publish","date":"2024-12-02 19:25:55","date_utc":"0000-00-00 00:00:00","modified":"2024-12-02 19:25:55","modified_utc":"0000-00-00 00:00:00","url":"https:\/\/www.downtownboston.org\/organizer\/","organizer":"Revolutionary Spaces","website":"https:\/\/revolutionaryspaces.org\/","global_id":"www.downtownboston.org?id=16317","global_id_lineage":["www.downtownboston.org?id=16317"]}],"custom_fields":[],"is_virtual":false,"virtual_url":null,"virtual_video_source":""},{"id":10005511,"global_id":"www.downtownboston.org?id=10005511","global_id_lineage":["www.downtownboston.org?id=10005511"],"author":"6","status":"publish","date":"2026-07-07 18:16:19","date_utc":"2026-07-07 18:16:19","modified":"2026-07-22 21:08:50","modified_utc":"2026-07-22 21:08:50","url":"https:\/\/www.downtownboston.org\/event\/experience-the-ruckus\/2026-10-16\/","rest_url":"https:\/\/www.downtownboston.org\/wp-json\/tribe\/events\/v1\/events\/10005511","title":"Experience The Ruckus!","description":"<p><span style=\"font-weight: 400;\">Step inside Boston\u2019s historic Old South Meeting House and experience the <em>Ruckus!<\/em> that ignited the American Revolution. This 25-minute immersive show drops you right into the heart of the debate and defiance that once filled this iconic space, where ordinary people set extraordinary change in motion.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">From the floorboards to the balconies, you will be surrounded by dynamic sound, lighting, and projected animations of fiery revolutionaries, determined citizens, and some unlikely troublemakers whose courage shook these walls.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">For visitors, locals, and adventurers of all ages, <em>Ruckus!<\/em> is a powerful way to begin exploring Boston\u2019s pivotal role in shaping our nation\u2014a fast-paced and unforgettable reminder that a little Ruckus! can change everything.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Tickets also get you general admission to the Old State House and Old South Meeting House, including access to all exhibits, gallery talks, and tours.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\"><em>Ruckus!<\/em> is suitable for general audiences, with parental discretion is advised for younger children. The show includes loud sound effects (including gunfire), dynamic lighting, and moments that may feel intense for some visitors, particularly young children or those sensitive to loud noises or bright lights.<\/span><\/p>\n<p><span style=\"font-weight: 400;\"><em>Ruckus!<\/em> is made possible through the generous support of a local private foundation, with major support from The Lynch Foundation, The Hamilton Company Charitable Foundation, Massachusetts Office of Travel &amp; Tourism, Massachusetts 250, Meet Boston, and many generous individual supporters.<\/span><\/p>","excerpt":"","slug":"experience-the-ruckus","image":{"url":"https:\/\/www.downtownboston.org\/wp-content\/uploads\/2026\/07\/ruckus.jpg","id":460229,"extension":"jpg","width":800,"height":800,"filesize":70221,"sizes":{"medium":{"width":300,"height":300,"mime-type":"image\/jpeg","filesize":11620,"url":"https:\/\/www.downtownboston.org\/wp-content\/uploads\/2026\/07\/ruckus-300x300.jpg"},"thumbnail":{"width":150,"height":150,"mime-type":"image\/jpeg","filesize":4427,"url":"https:\/\/www.downtownboston.org\/wp-content\/uploads\/2026\/07\/ruckus-150x150.jpg"},"medium_large":{"width":768,"height":768,"mime-type":"image\/jpeg","filesize":46048,"url":"https:\/\/www.downtownboston.org\/wp-content\/uploads\/2026\/07\/ruckus-768x768.jpg"}}},"all_day":false,"start_date":"2026-10-16 10:00:00","start_date_details":{"year":"2026","month":"10","day":