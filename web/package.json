{
  "name": "getoffthecouch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:types": "json2ts -i ../schema/cityfeed.schema.json -o src/lib/feed.generated.ts --bannerComment \"/* GENERATED by \\`make schema\\` from gotc/schema.py — do not edit. */\" --unreachableDefinitions && json2ts -i ../schema/citydetails.schema.json -o src/lib/details.generated.ts --bannerComment \"/* GENERATED by \\`make schema\\` from gotc/schema.py — do not edit. */\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
